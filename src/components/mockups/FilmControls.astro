---
// Controlos comuns aos "vídeos" dos serviços (WebsiteFilm, AppFilm, ...): reproduzir/pausar/ver de novo, um botão
// por etapa com barra de progresso, e a legenda da etapa atual. Geridos por initFilms em scripts/motion.ts;
// estilos em films.css. Sem JavaScript ou com movimento reduzido, começa na última etapa.
interface Props {
  chapters: { label: string; caption: string }[];
}
const { chapters } = Astro.props;
const last = chapters.length - 1;
---
<div class="film-controls">
  <button type="button" class="film-play" data-film-play aria-label="Reproduzir vídeo">
    <svg class="film-i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" /></svg>
    <svg class="film-i-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
    <svg class="film-i-replay" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /><path d="M4 3v5h5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <div class="film-chapters" role="group" aria-label="Etapas do vídeo" style={`--n:${chapters.length}`}>
    {chapters.map((c, n) => (
      <button type="button" class="film-ch" data-film-ch={n} aria-label={`Etapa ${n + 1} de ${chapters.length}: ${c.label}`} aria-current={n === last ? 'step' : undefined}>
        <span class="film-track"><i class="film-fill"></i></span>
        <span class="film-ch-label" aria-hidden="true">{c.label}</span>
      </button>
    ))}
  </div>
</div>
<p class="film-caption" data-film-caption aria-live="off">
  {chapters.map((c, n) => <span data-film-cap={n} hidden={n !== last}><b>{c.label}.</b> {c.caption}</span>)}
</p>
