---
// Mini pré-visualização da interface para cada serviço (empresas fictícias).
// Com movimento, cada uma faz a sua ação quando o cartão fica .is-playing (ver motion.css e initServices):
// .sv-swap troca o texto .sv-a pelo .sv-b; --i escalona barras, notificações e vistos.
import Icon from '../ui/Icon.astro';
// O website tem a sua própria pré-visualização em vídeo (WebsiteFilm.astro).
interface Props { kind: 'app' | 'dashboard' | 'automation' | 'integration' | 'support' }
const { kind } = Astro.props;
---
<div class="sv-mini" aria-hidden="true">
  <div class="sv-inner">
    {kind === 'app' && (
      <div class="mk-mini-phone"><div class="mk-mini-scr">
        <span class="mk-name">Ginásio Órbita</span>
        <div class="mk-class"><b>Pilates · 18:00</b><span>Lugares disponíveis</span><em class="sv-swap"><span class="sv-a">Reservar</span><span class="sv-b">Reservado ✓</span></em></div>
        <div class="mk-class"><b>Treino funcional · 19:00</b><em class="done">Reservado ✓</em></div>
      </div></div>
    )}
    {kind === 'dashboard' && (
      <div>
        <div class="mk-tiles"><div><b>7</b><span>Reparações em curso</span></div><div><b>3</b><span>Prontas a entregar</span></div></div>
        <div class="mk-bars boxed">{[40, 65, 50, 80, 55, 70, 90].map((h, i) => <i style={`height:${h}%;--i:${i}`}></i>)}</div>
      </div>
    )}
    {kind === 'automation' && (
      <div class="mk-notes">
        <div class="mk-note" style="--i:0"><b>Lembrete enviado</b><span>Sessão amanhã às 14:00</span><span class="mk-ok sm"><Icon name="ok" class="size-3" strokeWidth={3} /></span></div>
        <div class="mk-note" style="--i:1"><b>Fatura enviada</b><span>Reparação concluída</span><span class="mk-ok sm"><Icon name="ok" class="size-3" strokeWidth={3} /></span></div>
        <div class="mk-note" style="--i:2"><b>Relatório semanal</b><span>Enviado para a gerência</span><span class="mk-ok sm"><Icon name="ok" class="size-3" strokeWidth={3} /></span></div>
      </div>
    )}
    {kind === 'integration' && (
      <div>
        <div class="mk-flow"><span>Website</span><i></i><span>Agenda</span><i></i><span>Lembrete</span><b class="sv-dot"></b></div>
        <div class="mk-cal">
          <div class="hd"><span>seg</span><span>ter</span><span>qua</span><span>qui</span><span>sex</span></div>
          <div class="gr"><i class="b"></i><i></i><i class="b"></i><i class="b"></i><i></i><i></i><i class="b"></i><i></i><i class="n"></i><i class="b"></i><i class="b"></i><i class="b"></i><i></i><i></i><i class="b"></i></div>
        </div>
      </div>
    )}
    {kind === 'support' && (
      <div class="mk-status">
        <div><span>Website e sistema</span><span class="mk-online">Online</span></div>
        <div style="--i:0"><span>Atualização de segurança aplicada</span><span class="mk-ok sm"><Icon name="ok" class="size-3" strokeWidth={3} /></span></div>
        <div style="--i:1"><span>Pedido de suporte respondido</span><span class="mk-ok sm"><Icon name="ok" class="size-3" strokeWidth={3} /></span></div>
      </div>
    )}
  </div>
</div>
