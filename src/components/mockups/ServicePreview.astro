---
// Mini pré-visualização da interface para cada serviço (empresas fictícias).
// Com movimento, cada uma faz a sua ação quando o cartão fica .is-playing (ver motion.css e initServices):
// --i escalona barras, notificações e vistos.
import Icon from '../ui/Icon.astro';
// Website, apps, gestão e automatizações têm a sua própria pré-visualização em vídeo (*Film.astro).
interface Props { kind: 'integration' | 'support' }
const { kind } = Astro.props;
---
<div class="sv-mini" aria-hidden="true">
  <div class="sv-inner">
    {kind === 'integration' && (
      <div>
        <div class="mk-flow"><span>Website</span><i></i><span>Agenda</span><i></i><span>Lembrete</span><b class="sv-dot"></b></div>
        <div class="mk-cal">
          <div class="hd"><span>seg</span><span>ter</span><span>qua</span><span>qui</span><span>sex</span></div>
          <div class="gr"><i class="b"></i><i></i><i class="b"></i><i class="b"></i><i></i><i></i><i class="b"></i><i></i><i class="n"></i><i class="b"></i><i class="b"></i><i class="b"></i><i></i><i></i><i class="b"></i></div>
        </div>
      </div>
    )}
    {kind === 'support' && (
      <div class="mk-status">
        <div><span>Website e sistema</span><span class="mk-online">Online</span></div>
        <div style="--i:0"><span>Atualização de segurança aplicada</span><span class="mk-ok sm"><Icon name="ok" class="size-3" strokeWidth={3} /></span></div>
        <div style="--i:1"><span>Pedido de suporte respondido</span><span class="mk-ok sm"><Icon name="ok" class="size-3" strokeWidth={3} /></span></div>
      </div>
    )}
  </div>
</div>
