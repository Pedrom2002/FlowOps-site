---
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';
import BrandF from '../ui/BrandF.astro';
import { getSection, getOrdered } from '../../lib/site';

const head = await getSection('commitments');
const items = await getOrdered('commitments');
---
<section class="section cm-section" id="compromissos" aria-labelledby="compromissos-title">
  <div class="container-site cm-wrap">
    <div class="cm-intro">
      <SectionHead id="compromissos-title" label={head.label} title={head.title} lead={head.lead} />
    </div>
    <p class="cm-more">Quer ver como fica numa proposta real? <a href="#contacto" class="tap inline-flex items-center">Falar connosco<Icon name="arrow" class="size-4" /></a></p>

    <!-- Os compromissos como um documento: cláusulas numeradas (2 × 2 no computador, para caber num ecrã).
         Com movimento, quando a folha aparece, cada cláusula recebe o visto, uma de cada vez
         (ver initCommit em scripts/motion.ts). -->
    <article class="cm-doc" aria-labelledby="cm-doc-title" data-cm>
      <header class="cm-head">
        <span class="cm-brand"><BrandF class="cm-logo" />FlowOps</span>
        <h3 id="cm-doc-title" class="cm-title">Compromisso de serviço</h3>
        <span class="cm-ref">Incluído em todas as propostas</span>
      </header>
      <ol class="cm-list">
        {items.map(({ data }, i) => (
          <li class="cm-item" style={`--i:${i}`}>
            <span class="cm-num" aria-hidden="true">{i + 1}.</span>
            <div class="cm-body">
              <h4>{data.title}</h4>
              <p>{data.text}</p>
              {data.practice && <p class="cm-practice"><Icon name={data.icon} class="size-[1.05em] shrink-0" /><span><b>Na prática:</b> {data.practice}</span></p>}
            </div>
            <span class="cm-tick" aria-hidden="true"><Icon name="ok" class="size-[0.95rem]" strokeWidth={2.8} /></span>
          </li>
        ))}
      </ol>
    </article>
  </div>
</section>
