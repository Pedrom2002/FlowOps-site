---
import SectionHead from '../ui/SectionHead.astro';
import Icon from '../ui/Icon.astro';
import BrandF from '../ui/BrandF.astro';
import { getSection, getOrdered } from '../../lib/site';

const head = await getSection('method');
const steps = await getOrdered('steps');
---
<section class="section on-dark relative overflow-hidden bg-brand-strong text-white" id="metodo" aria-labelledby="metodo-title">
  <BrandF class="wm-f text-white opacity-5" />
  <div class="container-site relative z-[1]">
    <SectionHead id="metodo-title" label={head.label} title={head.title} lead={head.lead} tone="dark" />
    <!-- Linha do tempo: em cima de cada nó, o que o cliente recebe nesse passo (cartões ilustrativos e
         decorativos, todos com a mesma anatomia: cabeçalho, dados, rodapé com estado); por baixo, o passo.
         Quando a secção aparece, a linha desenha-se do 1 ao fim (--lp de 0 a 1) e cada cartão aparece quando o nó acende
         (.lit, ver initFlow em scripts/motion.ts). -->
    <div class="mt-flow" data-flow>
      <div class="mt-line" aria-hidden="true"><i></i><b></b></div>
      <ol class="mt-steps">
        {steps.map(({ id, data }, i) => (
          <li class="mt-step">
            <div class="mt-obj" aria-hidden="true">
              {id === 'diagnostico' && (
                <>
                  <span class="mt-head"><span class="mt-ico"><Icon name="clock" class="size-[1.15em]" /></span><b>Reunião de diagnóstico</b></span>
                  <span class="mt-body">
                    <span class="mt-kv"><span>Data</span><b>Terça, 10:00</b></span>
                    <span class="mt-kv"><span>Duração</span><b>45 min</b></span>
                    <span class="mt-kv"><span>Custo</span><b>Gratuito</b></span>
                  </span>
                  <span class="mt-foot"><span class="mt-pill is-ok mt-pop">Confirmada</span><span>Convite enviado</span></span>
                </>
              )}
              {id === 'proposta' && (
                <>
                  <span class="mt-head"><span class="mt-ico"><Icon name="document" class="size-[1.15em]" /></span><b>Proposta</b><span class="mt-meta">N.º 024</span></span>
                  <span class="mt-body">
                    <span class="mt-kv"><span>Âmbito</span><b>Definido</b></span>
                    <span class="mt-kv"><span>Preço</span><b>Fixo</b></span>
                    <span class="mt-kv"><span>Prazo</span><b>Acordado</b></span>
                  </span>
                  <span class="mt-foot"><span class="mt-pill is-ok mt-pop">Aceite</span><span>Assinada</span></span>
                </>
              )}
              {id === 'desenvolvimento' && (
                <>
                  <span class="mt-head"><span class="mt-ico"><Icon name="dashboard" class="size-[1.15em]" /></span><b>Projeto</b><span class="mt-meta">Fase 2 de 3</span></span>
                  <span class="mt-body">
                    <span class="mt-progress"><span class="mt-bar"><i></i></span><b>60%</b></span>
                    <span class="mt-kv"><span>Base</span><span class="mt-pill is-ok">Concluída</span></span>
                    <span class="mt-kv"><span>Pedidos</span><span class="mt-pill is-wait">Em curso</span></span>
                    <span class="mt-kv"><span>Faturas</span><span class="mt-pill">Planeada</span></span>
                  </span>
                </>
              )}
              {id === 'entrega-e-suporte' && (
                <>
                  <span class="mt-head"><span class="mt-ico"><Icon name="shield" class="size-[1.15em]" /></span><b>O seu site</b><span class="mt-pill is-ok is-live">Online</span></span>
                  <span class="mt-body">
                    <span class="mt-kv"><span>Cópias de segurança</span><b>Diárias</b></span>
                    <span class="mt-kv"><span>Atualizações</span><b>Em dia</b></span>
                    <span class="mt-kv"><span>Último pedido</span><b class="mt-pop">Resolvido</b></span>
                  </span>
                  <span class="mt-foot"><span class="mt-btn">Pedir alteração</span></span>
                </>
              )}
            </div>
            <span class="mt-node" aria-hidden="true" data-flow-node>{String(i + 1).padStart(2, '0')}</span>
            <div class="mt-txt reveal">
              <h3><span class="sr-only">Passo {i + 1}: </span>{data.title}</h3>
              {data.badge && <span class="mt-badge">{data.badge}</span>}
              <p>{data.text}</p>
            </div>
          </li>
        ))}
        <li class="mt-end" aria-hidden="true" data-flow-end>
          <span class="mt-end-node"><Icon name="ok" class="size-6" strokeWidth={2.6} /></span>
          <span class="mt-end-label">{head.endLabel}</span>
        </li>
      </ol>
    </div>
  </div>
</section>
