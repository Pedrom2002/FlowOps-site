---
import SectionHead from '../ui/SectionHead.astro';
import ServicePreview from '../mockups/ServicePreview.astro';
import WhatsAppIcon from '../ui/WhatsAppIcon.astro';
import { getSection, getOrdered, getSettings, whatsappHref, isExternal } from '../../lib/site';

const head = await getSection('services');
const items = await getOrdered('services');
const s = await getSettings();
const contact = (about: string) => whatsappHref(s.contacts.whatsapp, `Olá! Vi o site da ${s.name} e gostava de falar sobre ${about}.`);
---
<section class="section bg-soft" id="servicos" aria-labelledby="servicos-title" data-sv>
  <div class="container-site">
    <SectionHead id="servicos-title" label={head.label} title={head.title} lead={head.lead} />

    <!-- Separadores: um por serviço; cada um abre o seu painel (initServices em scripts/motion.ts).
         Sem JavaScript, a barra some e os painéis aparecem todos, uns por baixo dos outros. -->
    <div class="reveal">
      <div class="sv-tabs" role="tablist" aria-label="Serviços">
        {items.map(({ id, data }, n) => (
          <button type="button" role="tab" class="sv-tab" id={`sv-tab-${id}`} aria-controls={`sv-panel-${id}`} aria-selected={n === 0 ? 'true' : 'false'} tabindex={n === 0 ? 0 : -1} data-sv-tab>
            {data.title}
          </button>
        ))}
      </div>

      {items.map(({ id, data }, n) => {
        const href = contact(data.about);
        return (
          <div class="sv-card sv-panel" role="tabpanel" id={`sv-panel-${id}`} aria-labelledby={`sv-tab-${id}`} tabindex="0" hidden={n !== 0} data-sv-panel>
            <div class="sv-stage"><ServicePreview kind={data.preview} /></div>
            <div class="sv-body">
              <h3 class="sv-title">{data.title}</h3>
              <p class="text-muted">{data.text}</p>
              <h4 class="sv-subtitle">Como trabalhamos</h4>
              <ol class="sv-steps">
                {data.steps.map((step) => <li>{step}</li>)}
              </ol>
              <p class="sv-example"><span class="font-semibold text-brand-strong">Exemplo:</span> {data.example}</p>
              <a href={href} class="btn btn-primary w-full sm:w-auto sm:justify-self-start" {...(isExternal(href) ? { target: '_blank', rel: 'noopener' } : {})}>
                {s.contacts.whatsapp && <WhatsAppIcon />}Falar sobre {data.about}
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
  <!-- O [hidden] do Tailwind usa !important na camada base; um !important só ganha numa camada anterior (theme). -->
  <noscript><style>.sv-tabs { display: none; } @layer theme { .sv-panel[hidden] { display: grid !important; } } .sv-panel + .sv-panel { margin-top: 16px; }</style></noscript>
</section>
